{
  "mcpServers": {
    "google-ads": {
      "command": "pipx",
      "args": ["run", "--spec", "git+https://github.com/googleads/google-ads-mcp.git@9a78cbdceebae71a6bc8483bdec333695834ef9c", "google-ads-mcp"],
      "env": {
        "GOOGLE_APPLICATION_CREDENTIALS": "${user_config.adc_path}",
        "GOOGLE_PROJECT_ID": "${user_config.gcp_project_id}",
        "GOOGLE_ADS_LOGIN_CUSTOMER_ID": "${user_config.login_customer_id}"
      }
    }
  }
}
